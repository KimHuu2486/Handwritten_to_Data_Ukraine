{
  "input": {
    "metadata_path": "/mnt/data/rukopys/test/metadata.jsonl",
    "image_roots": [
      "/mnt/data/rukopys/test",
      "/mnt/data/rukopys/test/images",
      "dataset/test"
    ]
  },
  "model": {
    "base_model_path": "/mnt/models/Qwen3-VL-8B-Instruct",
    "adapter_path": "artifacts/main_pipeline/phase1/checkpoints/ckpt_phase1_gt_baseline"
  },
  "model_load": {
    "load_in_4bit": false,
    "torch_dtype": "float16",
    "device": "cuda:0",
    "trust_remote_code": true,
    "attn_implementation": "sdpa",
    "low_cpu_mem_usage": true
  },
  "logging": {
    "transformers_verbosity": "error"
  },
  "generation": {
    "max_pixels_page": 850000,
    "max_pixels_crop": 262144,
    "max_new_tokens_stage_a": 2048,
    "max_new_tokens_stage_b": 1024,
    "image_batch_size": 1,
    "stage_b_batch_size": 4,
    "crop_pad_ratio": 0.02
  },
  "output": {
    "predictions_csv": "artifacts/main_pipeline/phase1/predictions/phase1_test_predictions_debug.csv",
    "submission_csv": "artifacts/main_pipeline/phase1/submissions/submission_phase1.csv",
    "raw_outputs_jsonl": "artifacts/main_pipeline/phase1/predictions/phase1_test_raw_outputs.jsonl",
    "runtime_summary_json": "artifacts/main_pipeline/phase1/predictions/phase1_test_runtime_summary.json",
    "crops_dir": "artifacts/main_pipeline/phase1/predictions/test_crops_tmp",
    "progress_every": 10,
    "checkpoint_every": 5
  }
}
